<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' && title ? title : 'Estamos em Manutenção Programada' %> — Vista Bem</title>
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg?v=<%= assetVersion %>">
  <meta name="theme-color" content="#231236">
  <meta name="robots" content="noindex, nofollow, noarchive">

  <!-- Fontes Oficiais Vista Bem -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,600;0,6..96,700;1,6..96,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --purple-950: #160B24;
      --purple-900: #231236;
      --purple-800: #341B50;
      --purple-700: #4A2570;
      --purple-500: #7343A6;
      --purple-300: #B89CE0;
      --purple-100: #EAE4F2;
      --gold-600: #8C6B2F;
      --gold-500: #A68038;
      --gold-400: #C5A059;
      --gold-300: #D4B475;
      --gold-light: rgba(197, 160, 89, 0.15);
      --bg-body: #FAF8F5;
      --bg-card: #FFFFFF;
      --text-main: #1F1926;
      --text-muted: #5A5266;
      --border-color: #E4DFEC;
      --shadow-lg: 0 20px 48px rgba(35, 18, 54, 0.12);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: radial-gradient(circle at 50% 15%, #F3EEF9 0%, #FAF8F5 55%, #EDE6F5 100%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      line-height: 1.6;
    }

    .maintenance-wrapper {
      width: 100%;
      max-width: 640px;
      background: var(--bg-card);
      border-radius: var(--radius);
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow-lg);
      padding: 48px 38px;
      text-align: center;
      position: relative;
      overflow: hidden;
      animation: fadeIn 0.6s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Faixa de Acento Editorial no Topo */
    .top-accent-bar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 6px;
      background: linear-gradient(90deg, #231236, #4A2570, #C5A059, #4A2570, #231236);
    }

    /* Logo Principal */
    .brand-logo-area {
      margin-bottom: 24px;
    }

    .brand-logo-img {
      max-height: 48px;
      width: auto;
      object-fit: contain;
    }

    /* Selo Institucional */
    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--purple-100);
      color: var(--purple-800);
      padding: 7px 18px;
      border-radius: 30px;
      font-weight: 700;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      margin-bottom: 26px;
      border: 1px solid rgba(74, 37, 112, 0.12);
    }

    /* Ícone Animado Sofisticado */
    .icon-wrapper {
      position: relative;
      width: 104px;
      height: 104px;
      margin: 0 auto 28px;
      background: linear-gradient(135deg, #F5EFFB 0%, #EDE4F6 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--purple-700);
      border: 2px dashed var(--purple-300);
      box-shadow: 0 8px 24px rgba(74, 37, 112, 0.08);
      animation: pulseSoft 3.5s ease-in-out infinite;
    }

    @keyframes pulseSoft {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }

    .icon-decoration {
      position: absolute;
      bottom: -4px;
      right: -4px;
      width: 36px;
      height: 36px;
      background: var(--gold-400);
      color: #FFF;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 3px solid #FFF;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    /* Tipografia de Destaque */
    h1 {
      font-family: 'Bodoni Moda', serif;
      font-size: 2.25rem;
      color: var(--purple-900);
      margin-bottom: 16px;
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: -0.3px;
    }

    .description {
      font-size: 1.05rem;
      color: var(--text-muted);
      margin-bottom: 28px;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
      font-weight: 400;
    }

    /* Caixa de Previsão de Retorno */
    .return-box {
      background: #FDFCF9;
      border: 1px solid #ECE7DC;
      border-left: 4px solid var(--gold-400);
      padding: 15px 22px;
      border-radius: 12px;
      margin-bottom: 30px;
      display: inline-flex;
      align-items: center;
      gap: 14px;
      font-size: 0.95rem;
      color: var(--text-main);
      text-align: left;
      box-shadow: 0 4px 14px rgba(197, 160, 89, 0.08);
    }

    .return-box-icon {
      color: var(--gold-600);
      display: flex;
      align-items: center;
    }

    .return-box strong {
      display: block;
      color: var(--purple-900);
      font-size: 0.88rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .return-box span {
      font-size: 1rem;
      color: var(--text-main);
      font-weight: 600;
    }

    /* Seção de Contatos */
    .contact-title {
      font-size: 0.88rem;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .contact-buttons {
      display: flex;
      gap: 14px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 13px 24px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .btn-whatsapp {
      background: #25D366;
      color: #FFF;
      box-shadow: 0 6px 18px rgba(37, 211, 102, 0.25);
    }

    .btn-whatsapp:hover {
      background: #1EBE5D;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(37, 211, 102, 0.35);
    }

    .btn-instagram {
      background: linear-gradient(45deg, #F58529, #DD2A7B, #8134AF);
      color: #FFF;
      box-shadow: 0 6px 18px rgba(221, 42, 123, 0.25);
    }

    .btn-instagram:hover {
      opacity: 0.95;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(221, 42, 123, 0.35);
    }

    /* Rodapé */
    .footer-note {
      margin-top: 32px;
      font-size: 0.85rem;
      color: var(--text-muted);
      border-top: 1px solid var(--border-color);
      padding-top: 22px;
    }

    .admin-link {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.82rem;
      margin-top: 16px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s ease;
      opacity: 0.75;
      font-weight: 500;
    }

    .admin-link:hover {
      color: var(--purple-700);
      opacity: 1;
      text-decoration: underline;
    }

    @media (max-width: 520px) {
      .maintenance-wrapper {
        padding: 36px 20px;
      }
      h1 {
        font-size: 1.85rem;
      }
      .btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>

  <div class="maintenance-wrapper">
    <div class="top-accent-bar"></div>

    <!-- Logomarca Oficial -->
    <div class="brand-logo-area">
      <img src="/images/logo.svg?v=<%= assetVersion %>" alt="Vista Bem" class="brand-logo-img" onerror="this.style.display='none'">
    </div>

    <div class="brand-badge">
      <%- icon('sparkles', 14) %> Vista Bem · Moda Contemporânea
    </div>

    <div class="icon-wrapper">
      <%- icon('hanger', 46) %>
      <div class="icon-decoration">
        <%- icon('sparkles', 18) %>
      </div>
    </div>

    <h1><%= typeof title !== 'undefined' && title ? title : 'Estamos em Manutenção Programada' %></h1>

    <p class="description">
      <%= typeof message !== 'undefined' && message ? message : 'Estamos aprimorando nossa loja com novas coleções exclusivas de moda. Em instantes estaremos de volta para você!' %>
    </p>

    <% if (typeof estimatedReturn !== 'undefined' && estimatedReturn && estimatedReturn.trim() !== '') { %>
      <div class="return-box">
        <div class="return-box-icon">
          <%- icon('clock', 24) %>
        </div>
        <div>
          <strong>Previsão de Retorno</strong>
          <span><%= estimatedReturn %></span>
        </div>
      </div>
    <% } %>

    <div>
      <div class="contact-title">Deseja atendimento exclusivo ou tirar dúvidas?</div>
      <div class="contact-buttons">
        <% 
          const cleanPhone = (typeof whatsapp !== 'undefined' && whatsapp) ? whatsapp.replace(/\D/g, '') : '';
          const waUrl = cleanPhone 
            ? `https://wa.me/55${cleanPhone}?text=${encodeURIComponent('Olá! Gostaria de informações sobre as coleções da loja Vista Bem.')}` 
            : 'https://wa.me/?text=' + encodeURIComponent('Olá! Gostaria de informações sobre a loja Vista Bem.');
          const instaUrl = (typeof instagram !== 'undefined' && instagram && instagram.trim() !== '') 
            ? instagram 
            : 'https://instagram.com';
        %>
        <a href="<%= waUrl %>" target="_blank" rel="noopener" class="btn btn-whatsapp">
          <%- icon('whatsapp', 18) %> Falar no WhatsApp
        </a>
        <a href="<%= instaUrl %>" target="_blank" rel="noopener" class="btn btn-instagram">
          <%- icon('instagram', 18) %> Acompanhar no Instagram
        </a>
      </div>
    </div>

    <div class="footer-note">
      <p>Agradecemos imensamente a sua compreensão e preferência. 💜</p>
      <a href="/login" class="admin-link">
        <%- icon('lock', 14) %> Acesso Administrativo
      </a>
    </div>
  </div>

</body>
</html>
