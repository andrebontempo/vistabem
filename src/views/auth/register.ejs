<%- include('../partials/header') %>

<main class="container" style="padding: 50px 20px 90px; max-width: 500px;">
  <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 36px; box-shadow: var(--shadow-sm);">
    
    <div style="text-align: center; margin-bottom: 28px;">
      <h1 style="font-size: 1.8rem; margin-bottom: 6px;">Criar sua Conta</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Faça parte da família Vista Bem e aproveite ofertas exclusivas</p>
    </div>

    <% if (locals.googleEnabled) { %>
      <div style="margin-bottom: 24px;">
        <a href="/auth/google" class="btn btn-secondary btn-block" style="border-color: #DADCE0; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 12px; background: #fff; color: #3c4043;">
          <%- GOOGLE_ICON %>
          <span>Cadastrar com o Google</span>
        </a>
      </div>

      <div style="display: flex; align-items: center; text-align: center; margin: 20px 0; color: var(--text-light); font-size: 0.85rem;">
        <span style="flex: 1; border-bottom: 1px solid var(--border-color);"></span>
        <span style="padding: 0 12px;">ou com seus dados</span>
        <span style="flex: 1; border-bottom: 1px solid var(--border-color);"></span>
      </div>
    <% } %>

    <form action="/cadastro" method="POST">
      <!-- Honeypot -->
      <div style="display:none;"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
      <input type="hidden" name="redirect" value="<%= redirect %>">

      <div class="form-group">
        <label for="name" class="form-label">Nome Completo *</label>
        <input type="text" id="name" name="name" required autofocus class="form-control" placeholder="Seu nome">
      </div>

      <div class="form-group">
        <label for="email" class="form-label">E-mail *</label>
        <input type="email" id="email" name="email" required class="form-control" placeholder="seu@email.com">
      </div>

      <div class="form-group">
        <label for="phone" class="form-label">WhatsApp / Telefone</label>
        <input type="tel" id="phone" name="phone" class="form-control" placeholder="(00) 00000-0000">
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Senha * (mínimo 6 caracteres)</label>
        <input type="password" id="password" name="password" required minlength="6" class="form-control" placeholder="Crie uma senha segura">
      </div>

      <div class="form-group">
        <label for="confirmPassword" class="form-label">Confirme a Senha *</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" class="form-control" placeholder="Digite a senha novamente">
      </div>

      <p style="font-size: 0.8rem; color: var(--text-muted); margin: 16px 0;">
        Ao criar sua conta, você concorda com nossos <a href="/termos" style="color: var(--purple-700);">Termos de Uso</a> e <a href="/privacidade" style="color: var(--purple-700);">Política de Privacidade</a>.
      </p>

      <button type="submit" class="btn btn-primary btn-block">
        <span>Criar Conta</span>
      </button>
    </form>

    <div style="text-align: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color); font-size: 0.9rem;">
      Já possui conta? <a href="/login<%= redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" style="color: var(--purple-700); font-weight: 700;">Fazer Login</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
