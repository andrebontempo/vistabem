<%- include('../partials/header') %>

<main class="container" style="padding: 50px 20px 90px; max-width: 480px;">
  <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 36px; box-shadow: var(--shadow-sm);">
    
    <div style="text-align: center; margin-bottom: 28px;">
      <h1 style="font-size: 1.8rem; margin-bottom: 6px;">Recuperar Senha</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Digite seu e-mail para receber as instruções de redefinição</p>
    </div>

    <form action="/esqueci-senha" method="POST">
      <div style="display:none;"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>

      <div class="form-group">
        <label for="email" class="form-label">Seu E-mail Cadastrado</label>
        <input type="email" id="email" name="email" required autofocus class="form-control" placeholder="seu@email.com">
      </div>

      <button type="submit" class="btn btn-primary btn-block" style="margin-top: 24px;">
        <span>Enviar Instruções</span>
      </button>
    </form>

    <div style="text-align: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color); font-size: 0.9rem;">
      Lembrou sua senha? <a href="/login" style="color: var(--purple-700); font-weight: 700;">Voltar ao Login</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
