<%- include('../partials/header') %>

<main class="container" style="padding: 50px 20px 90px; max-width: 480px;">
  <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 36px; box-shadow: var(--shadow-sm);">
    
    <div style="text-align: center; margin-bottom: 28px;">
      <h1 style="font-size: 1.8rem; margin-bottom: 6px;">Nova Senha</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Crie uma nova senha segura para acessar sua conta</p>
    </div>

    <form action="/redefinir-senha/<%= token %>" method="POST">
      <div class="form-group">
        <label for="password" class="form-label">Nova Senha (mínimo 6 dígitos)</label>
        <input type="password" id="password" name="password" required minlength="6" autofocus class="form-control" placeholder="Nova senha">
      </div>

      <div class="form-group">
        <label for="confirmPassword" class="form-label">Confirme a Nova Senha</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" class="form-control" placeholder="Confirme a nova senha">
      </div>

      <button type="submit" class="btn btn-primary btn-block" style="margin-top: 24px;">
        <span>Salvar Nova Senha</span>
      </button>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
