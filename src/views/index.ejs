<%- include('partials/header') %>

<main>
  <!-- Hero Section Editorial com Ilustração SVG Oficial -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            <%- icon('sparkles', 16) %>
            <span>Nova Coleção 2026/2027</span>
          </div>
          <h1 class="hero-title">
            Moda que expressa sua essência com <span class="highlight-gold">autenticidade</span>.
          </h1>
          <p class="hero-desc">
            Peças exclusivas com caimento impecável, tecidos nobres e acabamentos pensados para valorizar todas as idades e estilos.
          </p>
          <div class="hero-actions">
            <a href="/loja" class="btn btn-primary">
              <span>Explorar Coleções</span>
              <%- icon('arrow-right', 18) %>
            </a>
            <a href="/categoria/feminino" class="btn btn-secondary">
              <span>Ver Novidades</span>
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <img src="/images/hero-art.svg?v=<%= assetVersion %>" alt="Clientes elegantes Vista Bem" class="hero-art-img" width="440" height="480">
        </div>
      </div>
    </div>
  </section>

  <!-- Faixa de Diferenciais -->
  <section class="features-strip">
    <div class="container">
      <div class="features-grid">
        <div class="feature-box">
          <div class="feature-icon-wrapper"><%- icon('truck', 24) %></div>
          <div>
            <h4 class="feature-title">Envio para Todo o Brasil</h4>
            <p class="feature-desc">Entregas seguras com frete grátis acima de R$ 299</p>
          </div>
        </div>

        <div class="feature-box">
          <div class="feature-icon-wrapper"><%- icon('card', 24) %></div>
          <div>
            <h4 class="feature-title">Até 6x Sem Juros</h4>
            <p class="feature-desc">Ou 5% de desconto imediato no Pix</p>
          </div>
        </div>

        <div class="feature-box">
          <div class="feature-icon-wrapper"><%- icon('refresh', 24) %></div>
          <div>
            <h4 class="feature-title">Primeira Troca Grátis</h4>
            <p class="feature-desc">Até 30 dias para trocar suas peças com tranquilidade</p>
          </div>
        </div>

        <div class="feature-box">
          <div class="feature-icon-wrapper"><%- icon('shield', 24) %></div>
          <div>
            <h4 class="feature-title">Compra 100% Segura</h4>
            <p class="feature-desc">Ambiente criptografado com checkout Mercado Pago</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento Grid de Categorias -->
  <section class="categories-section">
    <div class="container">
      <div class="section-title">
        <h2>Escolha por Categoria</h2>
        <p>Descubra as tendências pensadas especialmente para você</p>
      </div>

      <div class="bento-grid">
        <!-- Card Grande: Feminino -->
        <a href="/categoria/feminino" class="bento-card large">
          <img src="/images/categories/categoria-feminino.svg?v=<%= assetVersion %>" alt="Moda Feminina Vista Bem" class="bento-bg" loading="lazy">
          <div class="bento-overlay"></div>
          <div class="bento-content">
            <span class="badge badge-gold" style="margin-bottom: 8px;">Destaque</span>
            <h3 class="bento-title">Moda Feminina</h3>
            <span class="bento-link">Ver vestidos, saias e conjuntos <%- icon('chevron-right', 16) %></span>
          </div>
        </a>

        <!-- Card: Masculino -->
        <a href="/categoria/masculino" class="bento-card">
          <img src="/images/categories/categoria-masculino.svg?v=<%= assetVersion %>" alt="Moda Masculina Vista Bem" class="bento-bg" loading="lazy">
          <div class="bento-overlay"></div>
          <div class="bento-content">
            <h3 class="bento-title">Moda Masculina</h3>
            <span class="bento-link">Camisas e alfaiataria <%- icon('chevron-right', 16) %></span>
          </div>
        </a>

        <!-- Card: Infantil -->
        <a href="/categoria/infantil" class="bento-card">
          <img src="/images/categories/categoria-infantil.svg?v=<%= assetVersion %>" alt="Moda Infantil Vista Bem" class="bento-bg" loading="lazy">
          <div class="bento-overlay"></div>
          <div class="bento-content">
            <h3 class="bento-title">Moda Infantil</h3>
            <span class="bento-link">Conforto para os pequenos <%- icon('chevron-right', 16) %></span>
          </div>
        </a>

        <!-- Card: Acessórios -->
        <a href="/categoria/acessorios" class="bento-card wide">
          <img src="/images/categories/categoria-acessorios.svg?v=<%= assetVersion %>" alt="Bolsas e Acessórios Vista Bem" class="bento-bg" loading="lazy">
          <div class="bento-overlay"></div>
          <div class="bento-content">
            <h3 class="bento-title">Bolsas &amp; Acessórios</h3>
            <span class="bento-link">O toque final para o seu look <%- icon('chevron-right', 16) %></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Novos Lançamentos -->
  <section class="products-section">
    <div class="container">
      <div class="section-title">
        <h2>Novos Lançamentos</h2>
        <p>As últimas novidades que acabaram de chegar às nossas araras</p>
      </div>

      <div class="product-grid">
        <% if (newArrivals && newArrivals.length > 0) { %>
          <% newArrivals.forEach(function(product) { %>
            <div class="product-card">
              <div class="product-thumb-wrapper">
                <a href="/produto/<%= product.slug %>">
                  <img src="<%= (product.images && product.images[0]) || '/images/placeholder.svg' %>" alt="<%= product.name %>" class="product-thumb" loading="lazy">
                </a>
                <div class="product-badges">
                  <% if (product.isNewArrival) { %><span class="badge badge-new">Novo</span><% } %>
                  <% if (product.salePrice > 0 && product.salePrice < product.price) { %>
                    <span class="badge badge-sale">-<%= Math.round((1 - product.salePrice / product.price) * 100) %>%</span>
                  <% } %>
                </div>
                <button type="button" class="btn-wishlist <%= (locals.wishlistIds && wishlistIds.includes(product._id.toString())) ? 'active' : '' %>" data-id="<%= product._id %>" aria-label="Favoritar <%= product.name %>">
                  <%- icon('heart', 18) %>
                </button>
              </div>

              <div class="product-details">
                <span class="product-cat"><%= product.category ? product.category.name : 'Vista Bem' %></span>
                <h3 class="product-name">
                  <a href="/produto/<%= product.slug %>"><%= product.name %></a>
                </h3>

                <!-- Preço & Parcelamento -->
                <div class="product-price-row">
                  <div>
                    <% if (product.salePrice > 0 && product.salePrice < product.price) { %>
                      <span class="price-original"><%= money(product.price) %></span>
                      <span class="price-current"><%= money(product.salePrice) %></span>
                    <% } else { %>
                      <span class="price-current"><%= money(product.price) %></span>
                    <% } %>
                  </div>
                  <div class="price-installments">
                    até 6x de <%= money(((product.salePrice > 0 && product.salePrice < product.price ? product.salePrice : product.price) / 6)) %> sem juros
                  </div>
                </div>

                <!-- Chips de Tamanhos Disponíveis -->
                <% if (product.variants && product.variants.length > 0) { %>
                  <div class="product-sizes-chips">
                    <% const availableSizes = [...new Set(product.variants.filter(v => v.stock > 0).map(v => v.size))]; %>
                    <% availableSizes.slice(0, 5).forEach(function(sz) { %>
                      <span class="size-chip"><%= sz %></span>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div style="grid-column: 1 / -1; text-align: center; padding: 40px;">
            <p style="color: var(--text-muted);">Em breve novidades incríveis nesta seção.</p>
          </div>
        <% } %>
      </div>

      <div style="text-align: center; margin-top: 40px;">
        <a href="/loja" class="btn btn-secondary">Ver Todas as Peças</a>
      </div>
    </div>
  </section>

  <!-- Banner Editorial Meio de Página -->
  <section class="editorial-banner">
    <div class="container" style="max-width: 760px;">
      <span class="badge badge-gold" style="margin-bottom: 16px;">Exclusividade Vista Bem</span>
      <h2 class="editorial-banner-title">
        Vista-se de confiança todos os dias
      </h2>
      <p class="editorial-banner-desc">
        Acreditamos que o bom vestir transforma a autoestima. Peças atemporais, versáteis e com a elegância que acompanha a sua rotina.
      </p>
      <a href="/loja" class="btn btn-gold">Conhecer a Coleção Completa</a>
    </div>
  </section>

  <!-- Mais Vendidos / Destaques -->
  <% if (featuredProducts && featuredProducts.length > 0) { %>
    <section class="products-section">
      <div class="container">
        <div class="section-title">
          <h2>Mais Desejados</h2>
          <p>Os queridinhos das nossas clientes para você se inspirar</p>
        </div>

        <div class="product-grid">
          <% featuredProducts.forEach(function(product) { %>
            <div class="product-card">
              <div class="product-thumb-wrapper">
                <a href="/produto/<%= product.slug %>">
                  <img src="<%= (product.images && product.images[0]) || '/images/placeholder.svg' %>" alt="<%= product.name %>" class="product-thumb" loading="lazy">
                </a>
                <div class="product-badges">
                  <span class="badge badge-gold">Destaque</span>
                </div>
                <button type="button" class="btn-wishlist <%= (locals.wishlistIds && wishlistIds.includes(product._id.toString())) ? 'active' : '' %>" data-id="<%= product._id %>" aria-label="Favoritar <%= product.name %>">
                  <%- icon('heart', 18) %>
                </button>
              </div>

              <div class="product-details">
                <span class="product-cat"><%= product.category ? product.category.name : 'Vista Bem' %></span>
                <h3 class="product-name">
                  <a href="/produto/<%= product.slug %>"><%= product.name %></a>
                </h3>

                <div class="product-price-row">
                  <div>
                    <span class="price-current"><%= money(product.salePrice > 0 ? product.salePrice : product.price) %></span>
                  </div>
                  <div class="price-installments">
                    até 6x de <%= money((product.salePrice > 0 ? product.salePrice : product.price) / 6) %> sem juros
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </section>
  <% } %>
</main>

<%- include('partials/footer') %>
