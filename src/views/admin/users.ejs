<%- include('admin-header') %>

<!-- Topo da Seção -->
<div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; flex-wrap: wrap;">
  <div>
    <h1 style="font-size: 1.8rem; font-weight: 700; color: #F5F2EB; margin-bottom: 4px;">
      Gestão de Usuários e Clientes Cadastrados
    </h1>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
      Central unificada de controle de usuários, clientes, perfis de acesso e pedidos vinculados.
    </p>
  </div>
  
  <a href="/admin/clientes/novo" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 600; padding: 11px 22px; border-radius: 9999px; text-decoration: none;">
    <%- icon('plus', 16) %>
    <span>Adicionar Usuário / Cliente</span>
  </a>
</div>

<!-- Barra de Filtros e Busca Rápida -->
<div class="admin-card" style="padding: 18px 24px; margin-bottom: 24px;">
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;">
    <!-- Filtros de Perfil em Pílula -->
    <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
      <a href="/admin/clientes<%= searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '' %>" 
         class="btn btn-sm <%= currentRole === 'all' ? 'btn-primary' : 'btn-secondary' %>"
         style="border-radius: 9999px; padding: 6px 16px; font-size: 0.82rem;">
        Todos (<%= stats.total %>)
      </a>
      <a href="/admin/clientes?role=customer<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" 
         class="btn btn-sm <%= currentRole === 'customer' ? 'btn-primary' : 'btn-secondary' %>"
         style="border-radius: 9999px; padding: 6px 16px; font-size: 0.82rem;">
        Clientes (<%= stats.customers %>)
      </a>
      <a href="/admin/clientes?role=admin<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" 
         class="btn btn-sm <%= currentRole === 'admin' ? 'btn-primary' : 'btn-secondary' %>"
         style="border-radius: 9999px; padding: 6px 16px; font-size: 0.82rem;">
        Administradores (<%= stats.admins %>)
      </a>
    </div>

    <!-- Campo de Busca -->
    <form action="/admin/clientes" method="GET" style="display: flex; gap: 8px; align-items: center; margin: 0; min-width: 280px; max-width: 100%;">
      <% if (currentRole && currentRole !== 'all') { %>
        <input type="hidden" name="role" value="<%= currentRole %>">
      <% } %>
      <div style="position: relative; width: 100%;">
        <input type="text" name="q" value="<%= searchQuery %>" placeholder="Buscar por nome, e-mail ou tel..." 
               class="form-control" 
               style="height: 38px; font-size: 0.85rem; padding-left: 36px; padding-right: 12px; border-radius: 9999px;">
        <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; display: flex;">
          <%- icon('search', 16) %>
        </span>
      </div>
      <button type="submit" class="btn btn-secondary btn-sm" style="height: 38px; padding: 0 16px; border-radius: 9999px;" title="Buscar">
        Buscar
      </button>
      <% if (searchQuery || (currentRole && currentRole !== 'all')) { %>
        <a href="/admin/clientes" class="btn btn-secondary btn-sm" style="height: 38px; padding: 0 12px; border-radius: 9999px; color: var(--text-muted);" title="Limpar filtros">
          <%- icon('x', 14) %>
        </a>
      <% } %>
    </form>
  </div>
</div>

<!-- Tabela de Usuários & Clientes -->
<div class="admin-card" style="padding: 24px;">
  <% if (users && users.length > 0) { %>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th style="font-weight: 700;">Nome</th>
            <th style="font-weight: 700;">E-mail</th>
            <th style="font-weight: 700;">Telefone</th>
            <th style="font-weight: 700;">Perfil</th>
            <th style="font-weight: 700;">Pedidos Feitos</th>
            <th style="font-weight: 700;">Data de Cadastro</th>
            <th style="font-weight: 700; text-align: right; min-width: 140px;">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { 
            const isSelf = typeof user !== 'undefined' && user && u._id.toString() === user._id.toString();
            const userOrders = (typeof orderCountMap !== 'undefined' && (orderCountMap[u._id.toString()] || orderCountMap[(u.email || '').toLowerCase()])) || 0;
          %>
            <tr>
              <!-- Nome -->
              <td>
                <div style="font-weight: 700; color: #FFFFFF; font-size: 0.94rem; display: flex; align-items: center; gap: 8px;">
                  <span><%= u.name %></span>
                  <% if (isSelf) { %>
                    <span style="font-size: 0.68rem; background: rgba(212, 180, 117, 0.2); color: var(--gold-400); border: 1px solid rgba(212, 180, 117, 0.35); padding: 1px 6px; border-radius: 4px; font-weight: 600;">Você</span>
                  <% } %>
                </div>
              </td>

              <!-- E-mail -->
              <td style="color: var(--text-muted); font-size: 0.9rem;">
                <%= u.email %>
              </td>

              <!-- Telefone -->
              <td style="color: var(--text-muted); font-size: 0.9rem;">
                <%= u.phone || '-' %>
              </td>

              <!-- Perfil (Estilo Idêntico ao O Que É Isso) -->
              <td>
                <% if (u.role === 'admin') { %>
                  <span class="badge-status" style="background: rgba(251, 191, 36, 0.18); color: #FBBF24; border: 1px solid rgba(251, 191, 36, 0.35); border-radius: 9999px; font-weight: 700; font-size: 0.76rem; padding: 4px 12px; display: inline-flex; align-items: center; gap: 5px;">
                    <%- icon('crown', 13) %> Admin
                  </span>
                <% } else { %>
                  <span class="badge-status" style="background: rgba(34, 197, 94, 0.15); color: #4ADE80; border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 9999px; font-weight: 600; font-size: 0.76rem; padding: 4px 12px;">
                    Cliente
                  </span>
                <% } %>
              </td>

              <!-- Pedidos Feitos -->
              <td style="font-size: 0.9rem; font-weight: 600; color: #EDE8DF;">
                <%= userOrders %> pedido(s)
              </td>

              <!-- Data de Cadastro -->
              <td style="color: var(--text-muted); font-size: 0.88rem;">
                <%= date(u.createdAt) %>
              </td>

              <!-- Ações (Editar pílula + Lixeira) -->
              <td style="text-align: right;">
                <div style="display: flex; gap: 8px; align-items: center; justify-content: flex-end;">
                  <!-- Botão Editar -->
                  <a href="/admin/clientes/<%= u._id %>/editar" 
                     class="btn btn-secondary btn-sm" 
                     style="border-radius: 9999px; padding: 5px 14px; font-size: 0.82rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; border-color: rgba(212, 180, 117, 0.35); color: var(--gold-400); text-decoration: none;"
                     title="Editar dados e permissões do usuário">
                    <%- icon('edit', 13) %>
                    <span>Editar</span>
                  </a>

                  <!-- Botão Excluir -->
                  <% if (!isSelf) { %>
                    <form action="/admin/clientes/<%= u._id %>/excluir" method="POST" style="display: inline-block; margin: 0;" onsubmit="return confirm('ATENÇÃO: Deseja realmente excluir definitivamente a conta de &quot;<%= u.name %>&quot; (<%= u.email %>)? Esta ação é irreversível.');">
                      <button type="submit" 
                              class="btn btn-secondary btn-sm" 
                              style="border-radius: 8px; width: 34px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; color: #EF4444; border-color: rgba(239, 68, 68, 0.25); background: rgba(239, 68, 68, 0.08);" 
                              title="Excluir este usuário permanentemente">
                        <%- icon('trash', 14) %>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 48px 16px; color: var(--text-muted);">
      <div style="font-size: 2.2rem; margin-bottom: 12px; opacity: 0.6;">🔍</div>
      <h3 style="font-size: 1.15rem; color: #EDE8DF; margin-bottom: 6px;">Nenhum usuário encontrado</h3>
      <p style="font-size: 0.88rem; max-width: 420px; margin: 0 auto 18px auto;">
        Não encontramos contas correspondentes aos critérios de busca ou filtros aplicados.
      </p>
      <% if (searchQuery || (currentRole && currentRole !== 'all')) { %>
        <a href="/admin/clientes" class="btn btn-secondary btn-sm" style="border-radius: 9999px; padding: 8px 18px;">
          Limpar Filtros e Ver Todos
        </a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('admin-footer') %>
