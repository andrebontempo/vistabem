<%- include('admin-header') %>

<div style="margin-bottom: 24px;">
  <h1 style="font-size: 1.8rem;">Configurações Gerais da Loja</h1>
  <p style="color: var(--text-muted); font-size: 0.9rem;">Defina regras de frete regional, redes sociais, avisos e dados da empresa</p>
</div>

<form action="/admin/configuracoes" method="POST">
  <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 30px;">
    <!-- Coluna Esquerda: Regras Comerciais e Frete -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <input type="hidden" name="maintenanceSettingsIncluded" value="1">

      <!-- Modo de Manutenção Programada -->
      <div class="admin-card" style="border: 2px solid <%= settings.isMaintenanceMode ? '#F59E0B' : 'var(--border-color)' %>; background: <%= settings.isMaintenanceMode ? 'rgba(245, 158, 11, 0.05)' : 'var(--bg-card)' %>;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 16px;">
          <div>
            <h3 style="font-size: 1.2rem; display: flex; align-items: center; gap: 8px;">
              <%- icon('tools', 20) %> Modo de Manutenção Programada
            </h3>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
              Quando ativado, os clientes verão uma página elegante de manutenção (HTTP 503 com SEO preservado). Administradores logados continuam com acesso livre para pré-visualização.
            </p>
          </div>
          <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; background: <%= settings.isMaintenanceMode ? 'rgba(245, 158, 11, 0.2)' : 'rgba(21, 128, 61, 0.15)' %>; color: <%= settings.isMaintenanceMode ? '#D97706' : '#15803D' %>; white-space: nowrap;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: <%= settings.isMaintenanceMode ? '#D97706' : '#15803D' %>;"></span>
            <%= settings.isMaintenanceMode ? 'MANUTENÇÃO ATIVA' : 'LOJA ONLINE' %>
          </span>
        </div>

        <div style="background: rgba(0,0,0,0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 14px; margin-bottom: 18px;">
          <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 600; font-size: 0.95rem;">
            <input type="checkbox" name="isMaintenanceMode" value="true" <%= settings.isMaintenanceMode ? 'checked' : '' %> style="width: 18px; height: 18px; accent-color: var(--purple-700); cursor: pointer;">
            <span>Ativar Página de Manutenção (Bloquear visitantes comuns)</span>
          </label>
        </div>

        <div class="form-group">
          <label class="form-label">Título da Página de Manutenção</label>
          <input type="text" name="maintenanceTitle" value="<%= settings.maintenanceTitle || 'Estamos em Manutenção Programada' %>" class="form-control" placeholder="Ex: Estamos em Manutenção Programada">
        </div>

        <div class="form-group">
          <label class="form-label">Mensagem Explicativa aos Visitantes</label>
          <textarea name="maintenanceMessage" rows="3" class="form-control" placeholder="Descreva brevemente a manutenção e prepare o cliente para as novidades..."><%= settings.maintenanceMessage || 'Estamos aprimorando nossa loja com novas coleções exclusivas de moda. Em instantes estaremos de volta para você!' %></textarea>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label">Previsão de Retorno (Opcional)</label>
          <input type="text" name="maintenanceEstimatedReturn" value="<%= settings.maintenanceEstimatedReturn || '' %>" class="form-control" placeholder="Ex: Hoje às 20h00 ou Em aproximadamente 30 minutos">
        </div>
      </div>

      <!-- Dados Principais -->
      <div class="admin-card">
        <h3 style="font-size: 1.2rem; margin-bottom: 18px;">Informações da Marca</h3>

        <div class="form-group">
          <label class="form-label">Nome da Loja</label>
          <input type="text" name="storeName" value="<%= settings.storeName || 'Vista Bem' %>" class="form-control">
        </div>

        <div class="form-group">
          <label class="form-label">Aviso no Topo do Site (Topbar)</label>
          <input type="text" name="storeNotice" value="<%= settings.storeNotice || '' %>" class="form-control">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Valor Mínimo para Frete Grátis (R$)</label>
            <input type="number" step="0.01" name="freeShippingThreshold" value="<%= settings.freeShippingThreshold || 299 %>" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Desconto no Pix (%)</label>
            <input type="number" name="pixDiscountPercent" value="<%= settings.pixDiscountPercent || 5 %>" class="form-control">
          </div>
        </div>
      </div>

      <!-- Tabela Regional de Frete (MVP) -->
      <div class="admin-card">
        <h3 style="font-size: 1.2rem; margin-bottom: 14px;">Tabela Fixa de Frete por Região</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
          Calculada automaticamente a partir da faixa dos dígitos do CEP do cliente.
        </p>

        <% const reg = settings.shipping || {}; %>

        <div style="display: flex; flex-direction: column; gap: 14px;">
          <!-- Sudeste -->
          <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
            <strong style="color: var(--purple-900);">Sudeste (SP, RJ, MG, ES)</strong>
            <div class="form-row" style="margin-top: 6px;">
              <input type="number" step="0.01" name="shippingSE_fee" value="<%= reg.SE ? reg.SE.fee : 22.9 %>" class="form-control" placeholder="Valor (R$)">
              <input type="text" name="shippingSE_days" value="<%= reg.SE ? reg.SE.days : '3 a 6 dias úteis' %>" class="form-control" placeholder="Prazo">
            </div>
          </div>

          <!-- Sul -->
          <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
            <strong style="color: var(--purple-900);">Sul (PR, SC, RS)</strong>
            <div class="form-row" style="margin-top: 6px;">
              <input type="number" step="0.01" name="shippingS_fee" value="<%= reg.S ? reg.S.fee : 26.9 %>" class="form-control" placeholder="Valor (R$)">
              <input type="text" name="shippingS_days" value="<%= reg.S ? reg.S.days : '4 a 7 dias úteis' %>" class="form-control" placeholder="Prazo">
            </div>
          </div>

          <!-- Centro-Oeste -->
          <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
            <strong style="color: var(--purple-900);">Centro-Oeste (DF, GO, MT, MS)</strong>
            <div class="form-row" style="margin-top: 6px;">
              <input type="number" step="0.01" name="shippingCO_fee" value="<%= reg.CO ? reg.CO.fee : 29.9 %>" class="form-control" placeholder="Valor (R$)">
              <input type="text" name="shippingCO_days" value="<%= reg.CO ? reg.CO.days : '5 a 8 dias úteis' %>" class="form-control" placeholder="Prazo">
            </div>
          </div>

          <!-- Nordeste -->
          <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
            <strong style="color: var(--purple-900);">Nordeste (BA, PE, CE, PB, RN, AL, SE, PI, MA)</strong>
            <div class="form-row" style="margin-top: 6px;">
              <input type="number" step="0.01" name="shippingNE_fee" value="<%= reg.NE ? reg.NE.fee : 34.9 %>" class="form-control" placeholder="Valor (R$)">
              <input type="text" name="shippingNE_days" value="<%= reg.NE ? reg.NE.days : '7 a 10 dias úteis' %>" class="form-control" placeholder="Prazo">
            </div>
          </div>

          <!-- Norte -->
          <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
            <strong style="color: var(--purple-900);">Norte (AM, PA, RO, AC, RR, AP, TO)</strong>
            <div class="form-row" style="margin-top: 6px;">
              <input type="number" step="0.01" name="shippingN_fee" value="<%= reg.N ? reg.N.fee : 39.9 %>" class="form-control" placeholder="Valor (R$)">
              <input type="text" name="shippingN_days" value="<%= reg.N ? reg.N.days : '8 a 12 dias úteis' %>" class="form-control" placeholder="Prazo">
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Coluna Direita: Contato e Empresa -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <div class="admin-card">
        <h3 style="font-size: 1.2rem; margin-bottom: 18px;">Canais &amp; Redes Sociais</h3>

        <div class="form-group">
          <label class="form-label">WhatsApp de Atendimento</label>
          <input type="text" name="whatsapp" value="<%= settings.whatsapp || '' %>" class="form-control" placeholder="(11) 99999-9999">
        </div>

        <div class="form-group">
          <label class="form-label">E-mail de Suporte / Atendimento</label>
          <input type="email" name="contactEmail" value="<%= settings.contactEmail || 'atendimento@vistabem.com' %>" class="form-control">
        </div>

        <div class="form-group">
          <label class="form-label">Link do Instagram</label>
          <input type="url" name="instagram" value="<%= settings.instagram || '' %>" class="form-control" placeholder="https://instagram.com/vistabem">
        </div>

        <div class="form-group">
          <label class="form-label">Link do Facebook</label>
          <input type="url" name="facebook" value="<%= settings.facebook || '' %>" class="form-control" placeholder="https://facebook.com/vistabem">
        </div>

        <div class="form-group">
          <label class="form-label">Link do TikTok</label>
          <input type="url" name="tiktok" value="<%= settings.tiktok || '' %>" class="form-control" placeholder="https://tiktok.com/@vistabem">
        </div>
      </div>

      <div class="admin-card">
        <h3 style="font-size: 1.2rem; margin-bottom: 18px;">Dados da Empresa (Rodapé)</h3>

        <div class="form-group">
          <label class="form-label">Razão Social</label>
          <input type="text" name="companyName" value="<%= settings.companyName || 'Vista Bem Moda' %>" class="form-control">
        </div>

        <div class="form-group">
          <label class="form-label">CNPJ</label>
          <input type="text" name="cnpj" value="<%= settings.cnpj || '' %>" class="form-control" placeholder="00.000.000/0001-00">
        </div>

        <div class="form-group">
          <label class="form-label">Endereço Comercial</label>
          <input type="text" name="address" value="<%= settings.address || '' %>" class="form-control">
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="margin-top: 24px;">
          Salvar Todas as Configurações
        </button>
      </div>
    </div>
  </div>
</form>

<!-- Seção de Segurança: Alterar Senha do Administrador -->
<div class="admin-card" style="margin-top: 32px; border: 1px solid rgba(212, 180, 117, 0.3); background: rgba(212, 180, 117, 0.02);">
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 18px;">
    <div>
      <h3 style="font-size: 1.2rem; display: flex; align-items: center; gap: 8px; color: var(--gold-400);">
        <%- icon('lock', 20) %> Segurança &amp; Senha do Administrador
      </h3>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
        Altere a senha de acesso da sua conta administradora (<strong style="color: #fff;"><%= user ? user.email : 'admin' %></strong>) diretamente pelo painel.
      </p>
    </div>
    <span class="badge-status primary">Acesso Administrador</span>
  </div>

  <form action="/admin/perfil/senha" method="POST" style="max-width: 640px;">
    <div class="form-row">
      <div class="form-group" style="flex: 1;">
        <label class="form-label">Nova Senha (Mínimo 6 caracteres)</label>
        <input type="password" name="new_password" required minlength="6" class="form-control" placeholder="Digite sua nova senha">
      </div>
      <div class="form-group" style="flex: 1;">
        <label class="form-label">Confirmar Nova Senha</label>
        <input type="password" name="confirm_password" required minlength="6" class="form-control" placeholder="Confirme a nova senha">
      </div>
    </div>
    <button type="submit" class="btn btn-secondary btn-sm" style="border-color: rgba(212, 180, 117, 0.5); color: var(--gold-400); font-weight: 700; padding: 8px 18px; margin-top: 4px;">
      <%- icon('key', 15) %> <span>Atualizar Minha Senha de Administrador</span>
    </button>
  </form>
</div>

<%- include('admin-footer') %>
