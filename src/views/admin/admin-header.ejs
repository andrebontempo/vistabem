<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Painel de Gestão — Vista Bem' %></title>
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg?v=<%= assetVersion %>">
  <meta name="theme-color" content="#131118">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
</head>
<body class="admin-layout">
  <!-- Sidebar Administrativa -->
  <aside class="admin-sidebar">
    <div class="admin-brand">
      <a href="/" title="Ir para a Loja Virtual Vista Bem">
        <img src="/images/logo-white.svg?v=<%= assetVersion %>" alt="Vista Bem" width="160" height="42">
      </a>
      <div style="font-size: 0.72rem; letter-spacing: 2px; color: var(--gold-400); margin-top: 8px; font-weight: 700;">
        PAINEL DE GESTÃO
      </div>
    </div>

    <ul class="admin-nav">
      <li class="admin-nav-item <%= currentPath === '/admin' ? 'active' : '' %>">
        <a href="/admin"><%- icon('chart', 18) %> <span>Dashboard</span></a>
      </li>
      <li class="admin-nav-item <%= currentPath.startsWith('/admin/pedidos') ? 'active' : '' %>">
        <a href="/admin/pedidos"><%- icon('package', 18) %> <span>Pedidos</span></a>
      </li>
      <li class="admin-nav-item <%= currentPath.startsWith('/admin/produtos') ? 'active' : '' %>">
        <a href="/admin/produtos"><%- icon('hanger', 18) %> <span>Produtos</span></a>
      </li>
      <li class="admin-nav-item <%= currentPath.startsWith('/admin/categorias') ? 'active' : '' %>">
        <a href="/admin/categorias"><%- icon('layers', 18) %> <span>Categorias</span></a>
      </li>
      <li class="admin-nav-item <%= currentPath.startsWith('/admin/atributos') ? 'active' : '' %>">
        <a href="/admin/atributos"><%- icon('palette', 18) %> <span>Tamanhos &amp; Cores</span></a>
      </li>
      <li class="admin-nav-item <%= currentPath.startsWith('/admin/cupons') ? 'active' : '' %>">
        <a href="/admin/cupons"><%- icon('ticket', 18) %> <span>Cupons</span></a>
      </li>
      <li class="admin-nav-item <%= currentPath.startsWith('/admin/banners') ? 'active' : '' %>">
        <a href="/admin/banners"><%- icon('image', 18) %> <span>Banners Home</span></a>
      </li>
      <li class="admin-nav-item <%= currentPath.startsWith('/admin/avaliacoes') ? 'active' : '' %>">
        <a href="/admin/avaliacoes"><%- icon('star', 18) %> <span>Avaliações</span></a>
      </li>
      <li class="admin-nav-item <%= currentPath.startsWith('/admin/clientes') ? 'active' : '' %>">
        <a href="/admin/clientes"><%- icon('users', 18) %> <span>Clientes</span></a>
      </li>
      <li class="admin-nav-item <%= currentPath.startsWith('/admin/configuracoes') ? 'active' : '' %>">
        <a href="/admin/configuracoes" style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
          <div style="display: flex; align-items: center; gap: 12px;">
            <%- icon('settings', 18) %> <span>Configurações</span>
          </div>
          <% if (locals.settings && locals.settings.isMaintenanceMode) { %>
            <span title="Modo de Manutenção Ativo" style="width: 8px; height: 8px; border-radius: 50%; background: #F59E0B; display: inline-block; box-shadow: 0 0 8px #F59E0B;"></span>
          <% } %>
        </a>
      </li>
    </ul>

    <div style="padding: 20px; border-top: 1px solid rgba(255, 255, 255, 0.08);">
      <a href="/" target="_blank" class="btn btn-secondary btn-sm btn-block" style="background: rgba(255,255,255,0.08); color: #fff; border-color: transparent;">
        <%- icon('eye', 16) %> <span>Ver Loja Virtual</span>
      </a>
      <a href="/logout" style="display: block; text-align: center; color: #B79CF2; font-size: 0.82rem; margin-top: 12px;">Sair do Painel</a>
    </div>
  </aside>

  <!-- Conteúdo Principal -->
  <div class="admin-main">
    <header class="admin-topbar">
      <div class="admin-topbar-title">
        <%= typeof title !== 'undefined' ? title : 'Painel de Gestão' %>
      </div>
      <div class="admin-topbar-user" style="display: flex; align-items: center; gap: 14px;">
        <a href="/" class="btn btn-secondary btn-sm" style="background: rgba(255,255,255,0.06); color: var(--gold-400); border-color: rgba(212, 180, 117, 0.3); font-size: 0.8rem; padding: 5px 12px; display: inline-flex; align-items: center; gap: 6px;" title="Ir para a Loja Virtual">
          <%- icon('eye', 15) %> <span>Ver Loja</span>
        </a>
        <% if (locals.settings && locals.settings.isMaintenanceMode) { %>
          <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 20px; font-weight: 700; font-size: 0.75rem; background: rgba(245, 158, 11, 0.2); color: #F59E0B; border: 1px solid rgba(245, 158, 11, 0.4);">
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #F59E0B;"></span>
            MANUTENÇÃO ATIVA
          </span>
        <% } %>
        <span>Conectada como <strong><%= user ? user.name : 'Administradora' %></strong></span>
      </div>
    </header>

    <% if (locals.settings && locals.settings.isMaintenanceMode) { %>
      <div style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.4); color: #FBBF24; padding: 12px 24px; margin: 20px 32px 0 32px; border-radius: 10px; font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="color: #F59E0B; display: flex;"><%- icon('tools', 20) %></span>
          <span><strong>ATENÇÃO:</strong> A loja virtual está em <strong>Modo de Manutenção</strong>. Clientes externos estão vendo a tela de aviso (HTTP 503).</span>
        </div>
        <a href="/admin/configuracoes" class="btn btn-sm" style="background: #D97706; color: #FFF; border: none; font-size: 0.78rem; padding: 5px 14px; border-radius: 6px; text-decoration: none; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
          Ajustar / Desativar <%- icon('arrow-right', 12) %>
        </a>
      </div>
    <% } %>

    <%- include('../partials/flash') %>
    <main class="admin-content">
