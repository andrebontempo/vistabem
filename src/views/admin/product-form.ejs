<%- include('admin-header') %>

<div style="margin-bottom: 24px;">
  <a href="/admin/produtos" style="font-size: 0.85rem; color: var(--purple-700); font-weight: 700; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 8px;">
    <%- icon('chevron-left', 16) %> Voltar para Produtos
  </a>
  <h1 style="font-size: 1.8rem;"><%= product._id ? 'Editar Produto' : 'Cadastrar Novo Produto' %></h1>
</div>

<form action="<%= product._id ? '/admin/produtos/' + product._id + '/editar' : '/admin/produtos/novo' %>" method="POST" enctype="multipart/form-data">
  <div style="display: grid; grid-template-columns: 1.4fr 0.8fr; gap: 24px;">
    <!-- Coluna Esquerda: Dados Gerais e Variações -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <!-- Informações Básicas -->
      <div class="admin-card">
        <h3 style="font-size: 1.15rem; margin-bottom: 18px;">Informações Principais</h3>

        <div class="form-group">
          <label class="form-label">Nome do Produto *</label>
          <input type="text" name="name" required value="<%= product.name || '' %>" class="form-control" placeholder="Ex: Vestido Midi Canelado Elegance">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Categoria *</label>
            <select name="category" required class="form-control">
              <option value="">Selecione uma categoria</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat._id %>" <%= (product.category && product.category.toString() === cat._id.toString()) ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Preço Original (R$) *</label>
            <input type="number" step="0.01" name="price" required value="<%= product.price || '' %>" class="form-control" placeholder="199.90">
          </div>

          <div class="form-group">
            <label class="form-label">Preço Promocional (R$)</label>
            <input type="number" step="0.01" name="salePrice" value="<%= product.salePrice || '' %>" class="form-control" placeholder="159.90 (opcional)">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Descrição Breve</label>
          <input type="text" name="shortDescription" value="<%= product.shortDescription || '' %>" class="form-control" placeholder="Resumo em uma linha para a vitrine">
        </div>

        <div class="form-group">
          <label class="form-label">Descrição Completa</label>
          <textarea name="description" rows="4" class="form-control" placeholder="Detalhes do corte, caimento, ocasião de uso..."><%= product.description || '' %></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Composição dos Tecidos</label>
            <input type="text" name="composition" value="<%= product.composition || '' %>" class="form-control" placeholder="Ex: 96% Viscose, 4% Elastano">
          </div>
          <div class="form-group">
            <label class="form-label">Cuidados e Lavagem</label>
            <input type="text" name="care" value="<%= product.care || '' %>" class="form-control" placeholder="Ex: Lavagem suave à mão, não alvejar">
          </div>
        </div>
      </div>

      <!-- Variações de Tamanho, Cor & Estoque -->
      <div class="admin-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
          <div>
            <h3 style="font-size: 1.15rem;">Grade de Variações &amp; Estoque</h3>
            <p style="font-size: 0.85rem; color: var(--text-muted);">Defina os tamanhos, cores e estoques individuais desta peça</p>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" id="btn-add-variant">
            <%- icon('plus', 16) %> <span>Adicionar Variação</span>
          </button>
        </div>

        <div id="variants-container" style="display: flex; flex-direction: column; gap: 12px;">
          <% if (product.variants && product.variants.length > 0) { %>
            <% product.variants.forEach(function(v, i) { %>
              <div class="variant-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr 100px 40px; gap: 10px; align-items: center; background: var(--lilac-50); padding: 12px; border-radius: 8px;">
                <input type="text" name="variantSku" value="<%= v.sku %>" placeholder="SKU" class="form-control" style="font-size: 0.85rem;">
                <input type="text" name="variantSize" value="<%= v.size %>" placeholder="Tamanho (ex: P, M, 38)" class="form-control" style="font-size: 0.85rem;">
                <input type="text" name="variantColor" value="<%= v.color %>" placeholder="Cor (ex: Roxo)" class="form-control" style="font-size: 0.85rem;">
                <input type="number" name="variantStock" value="<%= v.stock %>" min="0" placeholder="Estoque" class="form-control" style="font-size: 0.85rem;">
                <button type="button" onclick="this.parentElement.remove()" style="color: var(--danger); font-size: 1.2rem; text-align: center;">&times;</button>
              </div>
            <% }); %>
          <% } else { %>
            <!-- Linhas Padrão Iniciais -->
            <% ['P', 'M', 'G'].forEach(function(sz) { %>
              <div class="variant-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr 100px 40px; gap: 10px; align-items: center; background: var(--lilac-50); padding: 12px; border-radius: 8px;">
                <input type="text" name="variantSku" placeholder="SKU" class="form-control" style="font-size: 0.85rem;">
                <input type="text" name="variantSize" value="<%= sz %>" placeholder="Tamanho" class="form-control" style="font-size: 0.85rem;">
                <input type="text" name="variantColor" placeholder="Cor" class="form-control" style="font-size: 0.85rem;">
                <input type="number" name="variantStock" value="5" min="0" placeholder="Estoque" class="form-control" style="font-size: 0.85rem;">
                <button type="button" onclick="this.parentElement.remove()" style="color: var(--danger); font-size: 1.2rem; text-align: center;">&times;</button>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Coluna Direita: Fotos e Status -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <!-- Fotos do Produto -->
      <div class="admin-card">
        <h3 style="font-size: 1.15rem; margin-bottom: 14px;">Fotos do Produto</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 14px;">
          As imagens serão otimizadas automaticamente para formato <strong>WebP</strong> leve e veloz.
        </p>

        <% if (product.images && product.images.length > 0) { %>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px;">
            <% product.images.forEach(function(img) { %>
              <div style="position: relative; border-radius: 6px; overflow: hidden; border: 1px solid var(--border-color);">
                <img src="<%= img %>" alt="" style="width: 100%; aspect-ratio: 3/4; object-fit: cover;">
                <input type="hidden" name="existingImages" value="<%= img %>">
                <button type="button" onclick="this.parentElement.remove()" style="position: absolute; top: 4px; right: 4px; background: rgba(0,0,0,0.6); color: #fff; width: 22px; height: 22px; border-radius: 999px; font-size: 0.8rem; display: flex; align-items: center; justify-content: center;">&times;</button>
              </div>
            <% }); %>
          </div>
        <% } %>

        <div class="form-group">
          <label class="form-label">Enviar Novas Imagens (JPG, PNG ou WEBP)</label>
          <input type="file" name="images" multiple accept="image/*" class="form-control" style="padding: 8px;">
        </div>
      </div>

      <!-- Visibilidade & Destaque -->
      <div class="admin-card">
        <h3 style="font-size: 1.15rem; margin-bottom: 16px;">Visibilidade</h3>

        <div style="display: flex; flex-direction: column; gap: 14px;">
          <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
            <input type="checkbox" name="active" <%= (product.active !== false) ? 'checked' : '' %>>
            <span style="font-weight: 600;">Produto Ativo na Vitrine</span>
          </label>

          <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
            <input type="checkbox" name="isNewArrival" <%= (product.isNewArrival) ? 'checked' : '' %>>
            <span style="font-weight: 600;">Selo "Novo Lançamento"</span>
          </label>

          <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
            <input type="checkbox" name="featured" <%= (product.featured) ? 'checked' : '' %>>
            <span style="font-weight: 600;">Destaque na Página Inicial</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="margin-top: 24px;">
          <span>Salvar Produto</span>
        </button>
      </div>
    </div>
  </div>
</form>

<script>
  document.getElementById('btn-add-variant')?.addEventListener('click', () => {
    const container = document.getElementById('variants-container');
    const row = document.createElement('div');
    row.className = 'variant-row';
    row.style.cssText = 'display: grid; grid-template-columns: 1fr 1fr 1fr 100px 40px; gap: 10px; align-items: center; background: var(--lilac-50); padding: 12px; border-radius: 8px;';
    row.innerHTML = `
      <input type="text" name="variantSku" placeholder="SKU" class="form-control" style="font-size: 0.85rem;">
      <input type="text" name="variantSize" placeholder="Tamanho" class="form-control" style="font-size: 0.85rem;">
      <input type="text" name="variantColor" placeholder="Cor" class="form-control" style="font-size: 0.85rem;">
      <input type="number" name="variantStock" value="1" min="0" placeholder="Estoque" class="form-control" style="font-size: 0.85rem;">
      <button type="button" onclick="this.parentElement.remove()" style="color: var(--danger); font-size: 1.2rem; text-align: center;">&times;</button>
    `;
    container.appendChild(row);
  });
</script>

<%- include('admin-footer') %>
