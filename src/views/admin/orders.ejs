<%- include('admin-header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
  <div>
    <h1 style="font-size: 1.8rem;">Gestão de Pedidos</h1>
    <p style="color: var(--text-muted); font-size: 0.9rem;">Acompanhe vendas, aprove pagamentos e despache mercadorias</p>
  </div>

  <!-- Filtro por Status -->
  <form method="GET" style="display: flex; gap: 8px;">
    <select name="status" class="form-control" style="width: auto;" onchange="this.form.submit()">
      <option value="">Todos os Status</option>
      <% orderStatuses.forEach(function(st) { %>
        <option value="<%= st %>" <%= selectedStatus === st ? 'selected' : '' %>><%= st %></option>
      <% }); %>
    </select>
  </form>
</div>

<div class="admin-card">
  <% if (orders && orders.length > 0) { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Pedido</th>
          <th>Data</th>
          <th>Cliente</th>
          <th>Itens</th>
          <th>Total</th>
          <th>Pagamento</th>
          <th>Status Pedido</th>
          <th style="text-align: right;">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(function(o) { %>
          <tr>
            <td><strong><%= o.orderNumber %></strong></td>
            <td><%= dateTime(o.createdAt) %></td>
            <td>
              <strong><%= o.customer.name %></strong>
              <div style="font-size: 0.78rem; color: var(--text-muted);"><%= o.customer.email %></div>
            </td>
            <td><%= o.items.length %> <%= o.items.length === 1 ? 'peça' : 'peças' %></td>
            <td><strong><%= money(o.total) %></strong></td>
            <td>
              <span class="badge-status <%= STATUS_CLASS[o.paymentStatus] || 'primary' %>"><%= o.paymentStatus %></span>
              <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;"><%= o.paymentMethod %></div>
            </td>
            <td>
              <span class="badge-status <%= STATUS_CLASS[o.orderStatus] || 'primary' %>"><%= o.orderStatus %></span>
            </td>
            <td style="text-align: right;">
              <a href="/admin/pedidos/<%= o._id %>" class="btn btn-secondary btn-sm">Ver / Gerenciar</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } else { %>
    <p style="color: var(--text-muted); text-align: center; padding: 40px 0;">Nenhum pedido encontrado para o filtro selecionado.</p>
  <% } %>
</div>

<%- include('admin-footer') %>
