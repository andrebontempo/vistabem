<%- include('../partials/header') %>

<main class="container" style="padding: 30px 20px 80px;">
  <!-- Breadcrumbs -->
  <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 20px;" aria-label="Navegação estrutural">
    <a href="/">Início</a> &rsaquo;
    <% if (currentCategory) { %>
      <a href="/loja">Coleções</a> &rsaquo;
      <span style="color: var(--purple-700); font-weight: 600;"><%= currentCategory.name %></span>
    <% } else { %>
      <span style="color: var(--purple-700); font-weight: 600;">Todas as Coleções</span>
    <% } %>
  </nav>

  <!-- Cabeçalho do Catálogo -->
  <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid var(--border-color);">
    <div>
      <h1 style="font-size: 2.2rem; margin-bottom: 6px;">
        <%= currentCategory ? currentCategory.name : selectedFilters.q ? `Resultados para "${selectedFilters.q}"` : 'Todas as Peças' %>
      </h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        <%= totalProducts %> <%= totalProducts === 1 ? 'produto encontrado' : 'produtos encontrados' %>
      </p>
    </div>

    <!-- Ordenação -->
    <form method="GET" style="display: flex; align-items: center; gap: 8px;">
      <% if (selectedFilters.q) { %><input type="hidden" name="q" value="<%= selectedFilters.q %>"><% } %>
      <label for="sort-select" style="font-size: 0.88rem; font-weight: 600; color: var(--text-muted);">Ordenar por:</label>
      <select id="sort-select" name="sort" class="form-control" style="width: auto; padding: 8px 14px; border-radius: var(--radius-pill);" onchange="this.form.submit()">
        <option value="novidades" <%= selectedFilters.sort === 'novidades' ? 'selected' : '' %>>Mais Recentes</option>
        <option value="mais-vendidos" <%= selectedFilters.sort === 'mais-vendidos' ? 'selected' : '' %>>Mais Vendidos</option>
        <option value="menor-preco" <%= selectedFilters.sort === 'menor-preco' ? 'selected' : '' %>>Menor Preço</option>
        <option value="maior-preco" <%= selectedFilters.sort === 'maior-preco' ? 'selected' : '' %>>Maior Preço</option>
        <option value="nome-az" <%= selectedFilters.sort === 'nome-az' ? 'selected' : '' %>>Nome (A-Z)</option>
      </select>
    </form>
  </div>

  <!-- Layout com Sidebar de Filtros e Grid de Produtos -->
  <div class="catalog-layout">
    <!-- Sidebar de Filtros -->
    <aside class="catalog-sidebar">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="font-size: 1.15rem;">Filtros</h3>
        <a href="/loja" style="font-size: 0.82rem; color: var(--purple-600); font-weight: 600;">Limpar</a>
      </div>

      <!-- Categorias -->
      <div style="margin-bottom: 24px;">
        <h4 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 12px;">Categorias</h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 8px;">
          <% if (availableCategories && availableCategories.length > 0) { %>
            <% availableCategories.forEach(function(cat) { %>
              <li>
                <a href="/categoria/<%= cat.slug %>" style="font-size: 0.92rem; font-weight: <%= (currentCategory && currentCategory._id.toString() === cat._id.toString()) ? '700' : '500' %>; color: <%= (currentCategory && currentCategory._id.toString() === cat._id.toString()) ? 'var(--purple-700)' : 'var(--text-main)' %>;">
                  <%= cat.name %>
                </a>
              </li>
            <% }); %>
          <% } %>
        </ul>
      </div>

      <!-- Tamanhos Comuns -->
      <div style="margin-bottom: 24px;">
        <h4 style="font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 12px;">Tamanho</h4>
        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
          <% ['PP', 'P', 'M', 'G', 'GG', '38', '40', '42', 'Único'].forEach(function(sz) { %>
            <a href="?size=<%= sz %><%= selectedFilters.sort ? '&sort=' + selectedFilters.sort : '' %>" class="size-chip" style="padding: 6px 12px; font-size: 0.82rem; font-weight: 700; <%= selectedFilters.size === sz ? 'background: var(--purple-700); color: #fff; border-color: var(--purple-700);' : '' %>">
              <%= sz %>
            </a>
          <% }); %>
        </div>
      </div>
    </aside>

    <!-- Grid de Produtos -->
    <div>
      <% if (products && products.length > 0) { %>
        <div class="product-grid">
          <% products.forEach(function(product) { %>
            <div class="product-card">
              <div class="product-thumb-wrapper">
                <a href="/produto/<%= product.slug %>">
                  <img src="<%= (product.images && product.images[0]) || '/images/placeholder.svg' %>" alt="<%= product.name %>" class="product-thumb" loading="lazy">
                </a>
                <div class="product-badges">
                  <% if (product.isNewArrival) { %><span class="badge badge-new">Novo</span><% } %>
                  <% if (product.salePrice > 0 && product.salePrice < product.price) { %>
                    <span class="badge badge-sale">-<%= Math.round((1 - product.salePrice / product.price) * 100) %>%</span>
                  <% } %>
                </div>
                <button type="button" class="btn-wishlist <%= (locals.wishlistIds && wishlistIds.includes(product._id.toString())) ? 'active' : '' %>" data-id="<%= product._id %>" aria-label="Favoritar <%= product.name %>">
                  <%- icon('heart', 18) %>
                </button>
              </div>

              <div class="product-details">
                <span class="product-cat"><%= product.category ? product.category.name : 'Coleção' %></span>
                <h3 class="product-name">
                  <a href="/produto/<%= product.slug %>"><%= product.name %></a>
                </h3>

                <div class="product-price-row">
                  <div>
                    <% if (product.salePrice > 0 && product.salePrice < product.price) { %>
                      <span class="price-original"><%= money(product.price) %></span>
                      <span class="price-current"><%= money(product.salePrice) %></span>
                    <% } else { %>
                      <span class="price-current"><%= money(product.price) %></span>
                    <% } %>
                  </div>
                  <div class="price-installments">
                    até 6x de <%= money(((product.salePrice > 0 && product.salePrice < product.price ? product.salePrice : product.price) / 6)) %> sem juros
                  </div>
                </div>

                <% if (product.variants && product.variants.length > 0) { %>
                  <div class="product-sizes-chips">
                    <% const availableSizes = [...new Set(product.variants.filter(v => v.stock > 0).map(v => v.size))]; %>
                    <% availableSizes.slice(0, 5).forEach(function(sz) { %>
                      <span class="size-chip"><%= sz %></span>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Paginação -->
        <% if (totalPages > 1) { %>
          <div style="display: flex; justify-content: center; gap: 8px; margin-top: 48px;">
            <% for (let p = 1; p <= totalPages; p++) { %>
              <a href="?page=<%= p %><%= selectedFilters.sort ? '&sort=' + selectedFilters.sort : '' %><%= selectedFilters.q ? '&q=' + selectedFilters.q : '' %>" class="btn btn-sm <%= currentPage === p ? 'btn-primary' : 'btn-secondary' %>" style="min-width: 40px;">
                <%= p %>
              </a>
            <% } %>
          </div>
        <% } %>

      <% } else { %>
        <div style="text-align: center; padding: 70px 20px; background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
          <img src="/images/placeholder.svg" alt="Nenhum produto" style="width: 140px; margin: 0 auto 20px; opacity: 0.6;">
          <h2 style="font-size: 1.5rem; margin-bottom: 8px;">Nenhum produto encontrado</h2>
          <p style="color: var(--text-muted); margin-bottom: 24px;">Tente ajustar os filtros ou buscar por outro termo.</p>
          <a href="/loja" class="btn btn-primary">Ver Todas as Peças</a>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
