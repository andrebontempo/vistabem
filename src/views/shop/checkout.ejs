<%- include('../partials/header') %>

<main class="container" style="padding: 30px 20px 80px;">
  <h1 style="font-size: 2.2rem; margin-bottom: 24px;">Finalizar Compra Segura</h1>

  <form action="/checkout" method="POST" id="checkout-form">
    <!-- Honeypot anti-bot -->
    <div style="display:none;"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>

    <div class="checkout-grid">
      <!-- Coluna da Esquerda: Dados de Entrega e Pagamento -->
      <div>
        <!-- 1. Identificação do Cliente -->
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 28px; margin-bottom: 24px;">
          <h2 style="font-size: 1.3rem; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <%- icon('user', 20) %>
            <span>1. Seus Dados Pessoais</span>
          </h2>

          <div class="form-row">
            <div class="form-group" style="grid-column: span 2;">
              <label for="name" class="form-label">Nome Completo *</label>
              <input type="text" id="name" name="name" required value="<%= user ? user.name : '' %>" class="form-control" placeholder="Seu nome completo">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="email" class="form-label">E-mail * (para envio do pedido e rastreio)</label>
              <input type="email" id="email" name="email" required value="<%= user ? user.email : '' %>" class="form-control" placeholder="seu@email.com">
            </div>
            <div class="form-group">
              <label for="phone" class="form-label">Telefone / WhatsApp *</label>
              <input type="tel" id="phone" name="phone" required value="<%= user ? user.phone : '' %>" class="form-control" placeholder="(00) 00000-0000">
            </div>
          </div>

          <div class="form-group" style="max-width: 240px;">
            <label for="cpf" class="form-label">CPF *</label>
            <input type="text" id="cpf" name="cpf" required value="<%= user ? user.cpf : '' %>" class="form-control" placeholder="000.000.000-00">
          </div>
        </div>

        <!-- 2. Endereço de Entrega -->
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 28px; margin-bottom: 24px;">
          <h2 style="font-size: 1.3rem; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <%- icon('pin', 20) %>
            <span>2. Endereço de Entrega</span>
          </h2>

          <div class="form-row">
            <div class="form-group">
              <label for="zipCode" class="form-label">CEP *</label>
              <input type="text" id="zipCode" name="zipCode" required maxlength="9" value="<%= cart.cep || (user && user.addresses && user.addresses[0] ? user.addresses[0].zipCode : '') %>" class="form-control" placeholder="00000-000">
              <span style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px; display: block;">Digite o CEP para buscar o endereço automaticamente</span>
            </div>
            <div class="form-group" style="grid-column: span 2;">
              <label for="street" class="form-label">Logradouro / Rua *</label>
              <input type="text" id="street" name="street" required value="<%= user && user.addresses && user.addresses[0] ? user.addresses[0].street : '' %>" class="form-control" placeholder="Rua, Avenida...">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="number" class="form-label">Número *</label>
              <input type="text" id="number" name="number" required value="<%= user && user.addresses && user.addresses[0] ? user.addresses[0].number : '' %>" class="form-control" placeholder="123">
            </div>
            <div class="form-group">
              <label for="complement" class="form-label">Complemento</label>
              <input type="text" id="complement" name="complement" value="<%= user && user.addresses && user.addresses[0] ? user.addresses[0].complement : '' %>" class="form-control" placeholder="Apto, Bloco...">
            </div>
            <div class="form-group">
              <label for="neighborhood" class="form-label">Bairro *</label>
              <input type="text" id="neighborhood" name="neighborhood" required value="<%= user && user.addresses && user.addresses[0] ? user.addresses[0].neighborhood : '' %>" class="form-control" placeholder="Bairro">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="city" class="form-label">Cidade *</label>
              <input type="text" id="city" name="city" required value="<%= user && user.addresses && user.addresses[0] ? user.addresses[0].city : '' %>" class="form-control" placeholder="Cidade">
            </div>
            <div class="form-group" style="max-width: 100px;">
              <label for="state" class="form-label">UF *</label>
              <input type="text" id="state" name="state" required maxlength="2" value="<%= user && user.addresses && user.addresses[0] ? user.addresses[0].state : '' %>" class="form-control" placeholder="SP">
            </div>
          </div>
        </div>

        <!-- 3. Forma de Pagamento -->
        <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 28px;">
          <h2 style="font-size: 1.3rem; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <%- icon('card', 20) %>
            <span>3. Forma de Pagamento</span>
          </h2>

          <input type="hidden" name="paymentMethod" id="selected-payment-method" value="pix">

          <!-- Opção Pix -->
          <div class="payment-method-card active" data-method="pix">
            <%- icon('sparkles', 24, 'text-purple') %>
            <div style="flex: 1;">
              <div style="font-weight: 700; font-size: 1.05rem;">Pix Instantâneo (5% de Desconto)</div>
              <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
                Aprovação em segundos. O QR Code e a chave Copia e Cola serão gerados na próxima tela.
              </div>
            </div>
            <span class="badge badge-sale">5% OFF</span>
          </div>

          <!-- Opção Cartão / Mercado Pago -->
          <div class="payment-method-card" data-method="mercadopago">
            <%- icon('card', 24) %>
            <div style="flex: 1;">
              <div style="font-weight: 700; font-size: 1.05rem;">Cartão de Crédito ou Boleto (Mercado Pago)</div>
              <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
                Parcele em até 6x sem juros com a segurança oficial do Mercado Pago.
              </div>
            </div>
          </div>

          <!-- Campo de Observações do Pedido -->
          <div class="form-group" style="margin-top: 20px;">
            <label for="notes" class="form-label">Observações sobre a entrega (opcional):</label>
            <textarea id="notes" name="notes" rows="2" class="form-control" placeholder="Ex: Deixar na portaria, ponto de referência..."></textarea>
          </div>
        </div>
      </div>

      <!-- Coluna da Direita: Resumo do Pedido -->
      <aside style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 28px; position: sticky; top: 100px;">
        <h3 style="font-size: 1.25rem; margin-bottom: 20px;">Resumo da Sacola</h3>

        <!-- Itens Miniatura -->
        <div style="max-height: 260px; overflow-y: auto; margin-bottom: 20px; padding-right: 6px;">
          <% cart.items.forEach(function(item) { %>
            <div style="display: flex; gap: 12px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">
              <img src="<%= item.image %>" alt="<%= item.product.name %>" style="width: 50px; height: 65px; object-fit: cover; border-radius: 6px;">
              <div style="flex: 1; font-size: 0.85rem;">
                <div style="font-weight: 600;"><%= item.product.name %></div>
                <div style="color: var(--text-muted); font-size: 0.78rem;">Tam: <%= item.variant.size %> · Qtd: <%= item.quantity %></div>
                <div style="font-weight: 700; color: var(--purple-900); margin-top: 2px;"><%= money(item.lineTotal) %></div>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Totais -->
        <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.92rem; margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Subtotal:</span>
            <span><%= money(cart.subtotal) %></span>
          </div>

          <% if (cart.discount > 0) { %>
            <div style="display: flex; justify-content: space-between; color: var(--success); font-weight: 600;">
              <span>Desconto de Cupom:</span>
              <span>- <%= money(cart.discount) %></span>
            </div>
          <% } %>

          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Frete:</span>
            <span><%= cart.shippingFee === 0 ? 'GRÁTIS' : money(cart.shippingFee) %></span>
          </div>

          <div id="pix-discount-note" style="display: flex; justify-content: space-between; color: var(--success); font-weight: 600;">
            <span>Desconto Pix (5%):</span>
            <span>- <%= money(cart.pixPreview) %></span>
          </div>

          <div style="display: flex; justify-content: space-between; padding-top: 14px; border-top: 1px solid var(--border-color); font-size: 1.35rem; font-weight: 800;">
            <span>Total a Pagar:</span>
            <span id="checkout-total-display" data-total-pix="<%= money(cart.totalPix) %>" data-total-standard="<%= money(cart.total) %>" style="color: var(--purple-900);">
              <%= money(cart.totalPix) %>
            </span>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="padding: 16px; font-size: 1.05rem;">
          <%- icon('lock', 20) %>
          <span>Confirmar e Pagar</span>
        </button>

        <p style="text-align: center; font-size: 0.78rem; color: var(--text-muted); margin-top: 14px; display: flex; align-items: center; justify-content: center; gap: 4px;">
          <%- icon('shield', 14) %>
          <span>Pagamento 100% Criptografado e Seguro</span>
        </p>
      </aside>
    </div>
  </form>
</main>

<script src="/js/checkout.js?v=<%= assetVersion %>"></script>
<%- include('../partials/footer') %>
