<%- include('../partials/header') %>

<main class="container" style="padding: 40px 20px 80px; max-width: 860px;" id="order-status-live" data-order-number="<%= order.orderNumber %>" data-access-key="<%= order.accessKey %>">
  <!-- Card Principal de Confirmação -->
  <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 36px; box-shadow: var(--shadow-sm); margin-bottom: 30px;">
    
    <div style="text-align: center; margin-bottom: 28px;">
      <% if (order.paymentStatus === 'Aprovado') { %>
        <div style="width: 64px; height: 64px; border-radius: 999px; background: var(--success-bg); color: var(--success); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
          <%- icon('check', 36) %>
        </div>
        <h1 style="font-size: 2rem; color: var(--purple-900);">Pagamento Aprovado com Sucesso! 💜</h1>
        <p style="color: var(--text-muted); font-size: 1.05rem; margin-top: 6px;">
          Recebemos a confirmação do seu pagamento. Seu pedido <strong><%= order.orderNumber %></strong> já está em fase de separação.
        </p>
      <% } else { %>
        <div style="width: 64px; height: 64px; border-radius: 999px; background: var(--warning-bg); color: var(--warning); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
          <%- icon('sparkles', 36) %>
        </div>
        <h1 style="font-size: 2rem; color: var(--purple-900);">Pedido <%= order.orderNumber %> Registrado!</h1>
        <p style="color: var(--text-muted); font-size: 1.05rem; margin-top: 6px;">
          Estamos aguardando a confirmação do seu pagamento para iniciar a separação das suas peças.
        </p>
      <% } %>
    </div>

    <!-- Bloco Pix (se pagamento pendente via Pix) -->
    <% if (order.paymentMethod === 'pix' && order.paymentStatus === 'Pendente') { %>
      <div style="background: var(--lilac-50); border: 2px dashed var(--purple-300); border-radius: var(--radius-md); padding: 28px; text-align: center; margin-bottom: 32px;">
        <h3 style="font-size: 1.3rem; margin-bottom: 12px; color: var(--purple-900);">Pague com Pix Instantâneo</h3>
        <p style="font-size: 0.95rem; color: var(--text-muted); margin-bottom: 20px;">
          Abra o aplicativo do seu banco, escolha a opção <strong>Pagar com Pix</strong> e aponte a câmera para o QR Code ou copie a chave:
        </p>

        <% if (order.mercadopago && order.mercadopago.pixQrBase64) { %>
          <div style="display: inline-block; padding: 12px; background: #fff; border-radius: 12px; box-shadow: var(--shadow-sm); margin-bottom: 20px;">
            <img src="data:image/png;base64,<%= order.mercadopago.pixQrBase64 %>" alt="QR Code Pix" style="width: 220px; height: 220px;">
          </div>
        <% } %>

        <div style="max-width: 540px; margin: 0 auto;">
          <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <input type="text" id="pix-code-input" readonly value="<%= (order.mercadopago && order.mercadopago.pixCode) || '' %>" class="form-control" style="flex: 1; min-width: 180px; font-size: 0.85rem; font-family: monospace; background: var(--bg-card); border-radius: var(--radius-pill);">
            <button type="button" id="btn-copy-pix" class="btn btn-primary btn-sm" style="white-space: nowrap;">Copiar Pix</button>
          </div>
          <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 10px;">
            Esta tela se atualiza automaticamente assim que o pagamento for concluído.
          </p>
        </div>
      </div>
    <% } %>

    <!-- Status Atual e Linha do Tempo -->
    <div style="background: var(--lilac-50); border-radius: var(--radius-md); padding: 20px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
      <div>
        <span style="font-size: 0.82rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Status do Pedido:</span>
        <div style="font-size: 1.25rem; font-weight: 800; color: var(--purple-700); margin-top: 2px;">
          <%= order.orderStatus %>
        </div>
      </div>

      <% if (order.trackingCode) { %>
        <div>
          <span style="font-size: 0.82rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Código de Rastreio:</span>
          <div style="font-size: 1.15rem; font-weight: 800; color: var(--purple-900); font-family: monospace;">
            <%= order.trackingCode %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Detalhes dos Itens do Pedido -->
    <h3 style="font-size: 1.25rem; margin-bottom: 16px;">Itens do Pedido</h3>
    <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 24px;">
      <% order.items.forEach(function(item) { %>
        <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 14px; border-bottom: 1px solid var(--border-color); gap: 12px; flex-wrap: wrap;">
          <div style="display: flex; gap: 14px; align-items: center;">
            <img src="<%= item.image || '/images/placeholder.svg' %>" alt="<%= item.name %>" style="width: 54px; height: 70px; object-fit: cover; border-radius: 6px;">
            <div>
              <div style="font-weight: 700; font-size: 1rem;"><%= item.name %></div>
              <div style="font-size: 0.85rem; color: var(--text-muted);">
                Tamanho: <%= item.size %> <%= item.color ? '· Cor: ' + item.color : '' %> · Quantidade: <%= item.quantity %>
              </div>
            </div>
          </div>
          <div style="font-weight: 800; font-size: 1.05rem; color: var(--purple-900);">
            <%= money(item.price * item.quantity) %>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Endereço de Entrega & Resumo -->
    <div class="order-summary-grid">
      <div>
        <h4 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 6px;">Endereço de Envio</h4>
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6;">
          <%= order.customer.name %><br>
          <%= order.shippingAddress.street %>, <%= order.shippingAddress.number %> <%= order.shippingAddress.complement %><br>
          <%= order.shippingAddress.neighborhood %> — <%= order.shippingAddress.city %>/<%= order.shippingAddress.state %><br>
          CEP: <%= order.shippingAddress.zipCode %>
        </p>
      </div>

      <div class="order-totals-col">
        <div style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 4px;">Subtotal: <%= money(order.subtotal) %></div>
        <% if (order.discount > 0) { %>
          <div style="font-size: 0.9rem; color: var(--success); margin-bottom: 4px;">Descontos: - <%= money(order.discount) %></div>
        <% } %>
        <div style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 6px;">Frete (<%= order.shippingMethod %>): <%= order.shippingFee === 0 ? 'GRÁTIS' : money(order.shippingFee) %></div>
        <div style="font-size: 1.4rem; font-weight: 800; color: var(--purple-900); padding-top: 8px; border-top: 1px solid var(--border-color);">
          Total: <%= money(order.total) %>
        </div>
      </div>
    </div>
  </div>

  <div style="text-align: center;">
    <a href="/loja" class="btn btn-secondary">Continuar Navegando</a>
  </div>
</main>

<script src="/js/checkout.js?v=<%= assetVersion %>"></script>
<%- include('../partials/footer') %>
