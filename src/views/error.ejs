<%- include('partials/header') %>

<main class="container" style="padding: 80px 20px 100px; text-align: center; max-width: 600px;">
  <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 50px 30px; box-shadow: var(--shadow-sm);">
    <div style="font-size: 4rem; font-weight: 800; color: var(--purple-700); font-family: 'Bodoni Moda', serif; line-height: 1; margin-bottom: 16px;">
      <%= typeof code !== 'undefined' ? code : 404 %>
    </div>
    <h1 style="font-size: 1.8rem; margin-bottom: 12px;"><%= typeof title !== 'undefined' ? title : 'Página Não Encontrada' %></h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 30px; line-height: 1.6;">
      <%= typeof message !== 'undefined' ? message : 'A página que você procura não foi encontrada ou mudou de endereço.' %>
    </p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary">Ir para a Página Inicial</a>
      <a href="/loja" class="btn btn-secondary">Ver Todas as Peças</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
