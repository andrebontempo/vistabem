<%- include('../partials/header') %>

<main class="container" style="padding: 40px 20px 80px; max-width: 900px;">
  <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
    <a href="/minha-conta">Minha Conta</a> &rsaquo; <span>Endereços</span>
  </nav>

  <h1 style="font-size: 2rem; margin-bottom: 24px;">Meus Endereços de Entrega</h1>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: start;">
    <!-- Lista de Endereços Salvos -->
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <% if (user.addresses && user.addresses.length > 0) { %>
        <% user.addresses.forEach(function(addr) { %>
          <div style="background: var(--bg-card); border: 1.5px solid <%= addr.isDefault ? 'var(--purple-700)' : 'var(--border-color)' %>; border-radius: var(--radius-md); padding: 20px; position: relative;">
            <% if (addr.isDefault) { %>
              <span class="badge badge-new" style="position: absolute; top: 16px; right: 16px;">Padrão</span>
            <% } %>
            <h3 style="font-size: 1.1rem; margin-bottom: 6px;"><%= addr.label || 'Casa' %></h3>
            <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6;">
              Destinatário: <strong><%= addr.recipient || user.name %></strong><br>
              <%= addr.street %>, <%= addr.number %> <%= addr.complement %><br>
              <%= addr.neighborhood %> — <%= addr.city %>/<%= addr.state %><br>
              CEP: <%= addr.zipCode %>
            </p>
            <form action="/minha-conta/enderecos/<%= addr._id %>/excluir" method="POST" style="margin-top: 14px;">
              <button type="submit" style="color: var(--danger); font-size: 0.82rem; font-weight: 700;">Excluir Endereço</button>
            </form>
          </div>
        <% }); %>
      <% } else { %>
        <p style="color: var(--text-muted);">Nenhum endereço cadastrado ainda.</p>
      <% } %>
    </div>

    <!-- Formulário de Novo Endereço -->
    <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 28px;">
      <h3 style="font-size: 1.25rem; margin-bottom: 20px;">Adicionar Novo Endereço</h3>
      <form action="/minha-conta/enderecos" method="POST">
        <div class="form-group">
          <label class="form-label">Identificação (ex: Casa, Trabalho)</label>
          <input type="text" name="label" required placeholder="Casa" class="form-control">
        </div>
        <div class="form-group">
          <label class="form-label">Nome de quem vai receber</label>
          <input type="text" name="recipient" value="<%= user.name %>" required class="form-control">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">CEP</label>
            <input type="text" name="zipCode" id="zipCode" maxlength="9" required class="form-control" placeholder="00000-000">
          </div>
          <div class="form-group" style="grid-column: span 2;">
            <label class="form-label">Rua / Logradouro</label>
            <input type="text" name="street" id="street" required class="form-control">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Número</label>
            <input type="text" name="number" id="number" required class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Complemento</label>
            <input type="text" name="complement" id="complement" class="form-control">
          </div>
          <div class="form-group">
            <label class="form-label">Bairro</label>
            <input type="text" name="neighborhood" id="neighborhood" required class="form-control">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Cidade</label>
            <input type="text" name="city" id="city" required class="form-control">
          </div>
          <div class="form-group" style="max-width: 90px;">
            <label class="form-label">UF</label>
            <input type="text" name="state" id="state" maxlength="2" required class="form-control">
          </div>
        </div>
        <div style="margin: 16px 0;">
          <label style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; cursor: pointer;">
            <input type="checkbox" name="isDefault">
            <span>Definir como meu endereço padrão de entrega</span>
          </label>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Salvar Endereço</button>
      </form>
    </div>
  </div>
</main>

<script src="/js/checkout.js?v=<%= assetVersion %>"></script>
<%- include('../partials/footer') %>
