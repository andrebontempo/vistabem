<%- include('../partials/header') %>

<main class="container" style="padding: 40px 20px 80px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 style="font-size: 2rem;">Minha Conta</h1>
      <p style="color: var(--text-muted);">Bem-vinda, <strong><%= user.name %></strong> (<%= user.email %>)</p>
    </div>
    <a href="/logout" class="btn btn-secondary btn-sm" style="display: flex; align-items: center; gap: 6px;">
      <%- icon('logout', 16) %>
      <span>Sair da Conta</span>
    </a>
  </div>

  <div style="display: grid; grid-template-columns: 260px 1fr; gap: 36px; align-items: start;">
    <!-- Menu Lateral da Conta -->
    <nav style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 20px;">
      <ul style="list-style: none; display: flex; flex-direction: column; gap: 6px;">
        <li>
          <a href="/minha-conta" class="btn btn-sm btn-primary btn-block" style="justify-content: flex-start; gap: 10px;">
            <%- icon('home', 18) %>
            <span>Visão Geral</span>
          </a>
        </li>
        <li>
          <a href="/minha-conta/pedidos" class="btn btn-sm btn-secondary btn-block" style="justify-content: flex-start; gap: 10px; border-color: transparent;">
            <%- icon('package', 18) %>
            <span>Meus Pedidos</span>
          </a>
        </li>
        <li>
          <a href="/minha-conta/enderecos" class="btn btn-sm btn-secondary btn-block" style="justify-content: flex-start; gap: 10px; border-color: transparent;">
            <%- icon('pin', 18) %>
            <span>Endereços</span>
          </a>
        </li>
        <li>
          <a href="/favoritos" class="btn btn-sm btn-secondary btn-block" style="justify-content: flex-start; gap: 10px; border-color: transparent;">
            <%- icon('heart', 18) %>
            <span>Meus Favoritos</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Conteúdo Central -->
    <div>
      <!-- Pedidos Recentes -->
      <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 28px; margin-bottom: 30px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <h2 style="font-size: 1.3rem;">Últimos Pedidos</h2>
          <a href="/minha-conta/pedidos" style="font-size: 0.88rem; color: var(--purple-600); font-weight: 700;">Ver todos</a>
        </div>

        <% if (orders && orders.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 16px;">
            <% orders.forEach(function(order) { %>
              <div style="border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
                <div>
                  <div style="font-weight: 700; color: var(--purple-900); font-size: 1.05rem;">
                    Pedido <%= order.orderNumber %>
                  </div>
                  <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
                    Feito em <%= date(order.createdAt) %> · <%= order.items.length %> <%= order.items.length === 1 ? 'item' : 'itens' %>
                  </div>
                </div>

                <div style="display: flex; align-items: center; gap: 18px;">
                  <span class="badge-status <%= STATUS_CLASS[order.orderStatus] || 'primary' %>">
                    <%= order.orderStatus %>
                  </span>
                  <div style="font-weight: 800; font-size: 1.1rem; color: var(--purple-900);">
                    <%= money(order.total) %>
                  </div>
                  <a href="/minha-conta/pedidos/<%= order._id %>" class="btn btn-secondary btn-sm">Detalhes</a>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p style="color: var(--text-muted); padding: 20px 0;">Você ainda não realizou nenhum pedido.</p>
          <a href="/loja" class="btn btn-primary btn-sm">Explorar Loja</a>
        <% } %>
      </div>

      <!-- Atualizar Perfil e Senha -->
      <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 28px;">
        <h2 style="font-size: 1.3rem; margin-bottom: 20px;">Meus Dados Pessoais</h2>
        <form action="/minha-conta/perfil" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="name" class="form-label">Nome Completo</label>
              <input type="text" id="name" name="name" value="<%= user.name %>" required class="form-control">
            </div>
            <div class="form-group">
              <label for="email" class="form-label">E-mail (não alterável)</label>
              <input type="email" id="email" value="<%= user.email %>" disabled class="form-control" style="background: var(--lilac-50);">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="phone" class="form-label">Telefone / WhatsApp</label>
              <input type="tel" id="phone" name="phone" value="<%= user.phone %>" class="form-control">
            </div>
            <div class="form-group">
              <label for="cpf" class="form-label">CPF</label>
              <input type="text" id="cpf" name="cpf" value="<%= user.cpf %>" class="form-control">
            </div>
          </div>

          <!-- Alteração de Senha se usuário local -->
          <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border-color);">
            <h3 style="font-size: 1.05rem; margin-bottom: 14px;">Alterar Senha de Acesso</h3>
            <% if (user.authProvider === 'local') { %>
              <div class="form-group" style="max-width: 320px;">
                <label for="currentPassword" class="form-label">Senha Atual</label>
                <input type="password" id="currentPassword" name="currentPassword" class="form-control" placeholder="Digite sua senha atual">
              </div>
            <% } %>
            <div class="form-row" style="max-width: 640px;">
              <div class="form-group">
                <label for="newPassword" class="form-label">Nova Senha (mínimo 6 dígitos)</label>
                <input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="Deixe em branco para não alterar">
              </div>
              <div class="form-group">
                <label for="confirmPassword" class="form-label">Confirme a Nova Senha</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Repita a nova senha">
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-sm" style="margin-top: 14px;">Salvar Alterações</button>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
