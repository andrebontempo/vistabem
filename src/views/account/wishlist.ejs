<%- include('../partials/header') %>

<main class="container" style="padding: 40px 20px 80px;">
  <div style="margin-bottom: 24px;">
    <h1 style="font-size: 2rem;">Meus Favoritos 💜</h1>
    <p style="color: var(--text-muted);">As peças que você amou e salvou para comprar quando quiser</p>
  </div>

  <% if (products && products.length > 0) { %>
    <div class="product-grid">
      <% products.forEach(function(product) { %>
        <div class="product-card">
          <div class="product-thumb-wrapper">
            <a href="/produto/<%= product.slug %>">
              <img src="<%= (product.images && product.images[0]) || '/images/placeholder.svg' %>" alt="<%= product.name %>" class="product-thumb" loading="lazy">
            </a>
            <button type="button" class="btn-wishlist active" data-id="<%= product._id %>" aria-label="Remover dos favoritos">
              <%- icon('heart', 18) %>
            </button>
          </div>

          <div class="product-details">
            <span class="product-cat"><%= product.category ? product.category.name : 'Vista Bem' %></span>
            <h3 class="product-name">
              <a href="/produto/<%= product.slug %>"><%= product.name %></a>
            </h3>

            <div class="product-price-row">
              <span class="price-current"><%= money(product.salePrice > 0 ? product.salePrice : product.price) %></span>
            </div>

            <div style="margin-top: 14px;">
              <a href="/produto/<%= product.slug %>" class="btn btn-primary btn-sm btn-block">Ver Detalhes</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 70px 20px; background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
      <%- icon('heart', 54, 'text-muted') %>
      <h2 style="font-size: 1.5rem; margin: 16px 0 8px;">Nenhuma peça favoritada</h2>
      <p style="color: var(--text-muted); margin-bottom: 24px;">Clique no coraçãozinho dos produtos para salvá-los aqui!</p>
      <a href="/loja" class="btn btn-primary">Ver Coleções</a>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
